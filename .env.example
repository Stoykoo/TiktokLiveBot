# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD DE DIRECTOS
# ==========================================

# Token de tu bot de Discord (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=TU_DISCORD_BOT_TOKEN_AQUI

# ID del canal de Discord donde se enviarán las alertas (Ejemplo: 123456789012345678)
# Para obtenerlo en Discord: Opciones -> Avanzado -> Modo Desarrollador -> Click derecho en el canal -> Copiar ID
NOTIFICATION_CHANNEL_ID=TU_ID_DE_CANAL_AQUI

# Plataforma a monitorear: 'tiktok' o 'twitch'
STREAM_PLATFORM=tiktok

# Nombre de usuario del creador (Sin el @)
STREAMER_USERNAME=tu_usuario_de_tiktok

# Rol a mencionar al notificar: 'everyone', 'here', o la ID del rol (ej. 987654321098765432). Déjalo vacío si no quieres mencionar a nadie.
PING_ROLE=everyone

# Tiempo entre revisiones (en segundos). Se recomienda 60 para evitar bloqueos por peticiones excesivas.
CHECK_INTERVAL_SECONDS=60

# Configuración opcional si usas Twitch:
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
