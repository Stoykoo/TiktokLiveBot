# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD DE DIRECTOS
# ==========================================

# Token de tu bot de Discord (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_discord_bot_token_aqui

# ID del canal de Discord donde se enviarán las alertas (Ej: 123456789012345678)
NOTIFICATION_CHANNEL_ID=123456789012345678

# Plataforma a monitorear: 'tiktok', 'twitch' o 'both'
STREAM_PLATFORM=both

# Nombre de usuario en TikTok (Sin el @)
STREAMER_USERNAME=tu_usuario_tiktok

# Nombre de usuario en Twitch (Sin el @) - opcional si es diferente al de TikTok
TWITCH_STREAMER_USERNAME=tu_usuario_twitch

# Rol a mencionar: 'everyone', 'here', un ID de rol, o vacío para no mencionar.
PING_ROLE=

# Tiempo entre revisiones (en segundos)
CHECK_INTERVAL_SECONDS=60

# Protección contra spam / flapping:
# Positivos consecutivos de la MISMA sesión antes de avisar (mínimo 2)
LIVE_CONFIRMATIONS=2

# Umbral de revisiones offline consecutivas para marcar directo como finalizado (por defecto 10 = 10 minutos)
OFFLINE_THRESHOLD=10

# Cooldown mínimo entre avisos. Una sesión nueva dentro de esta ventana se omite completa.
NOTIFY_COOLDOWN_MINUTES=120

# false evita volver a avisar al reiniciar el bot en medio de un directo.
NOTIFY_ON_STARTUP=false

# /test-notify solo funciona para administradores y tiene este cooldown.
TEST_NOTIFY_COOLDOWN_SECONDS=300

# Ruta del estado. En Render usa /var/data/state.json solo con un disco persistente.
# STATE_FILE=./state.json

# Twitch requiere la API oficial Helix. Crea una app en dev.twitch.tv.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
