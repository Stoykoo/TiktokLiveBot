# ==========================================
# CONFIGURACIÓN DEL BOT DE DISCORD DE DIRECTOS
# ==========================================

# Token de tu bot de Discord (Obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_discord_bot_token_aqui

# ID del canal de Discord donde se enviarán las alertas (Ej: 123456789012345678)
NOTIFICATION_CHANNEL_ID=123456789012345678

# Plataforma a monitorear: 'tiktok', 'twitch' o 'both'
STREAM_PLATFORM=both

# Nombre de usuario en TikTok (Sin el @)
STREAMER_USERNAME=tu_usuario_tiktok

# Nombre de usuario en Twitch (Sin el @) - opcional si es diferente al de TikTok
TWITCH_STREAMER_USERNAME=tu_usuario_twitch

# Rol a mencionar: 'everyone', 'here', o el ID de un rol específico. Leave blank for none.
PING_ROLE=everyone

# Tiempo entre revisiones (en segundos)
CHECK_INTERVAL_SECONDS=60

# Opcional (Para Twitch Helix API):
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
